{
  "name": "eilan",
  "version": "1.0.0",
  "description": "Eilañ : copie de rushs avec vérification par hash et rapport PDF",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "xxhash-wasm": "^1.0.2",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.eilan.app",
    "productName": "Eilan",
    "files": [
      "**/*"
    ],
    "mac": {
      "target": "dmg",
      "icon": "build/icon-mac.png"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "build/icon.png"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ]
  }
}
